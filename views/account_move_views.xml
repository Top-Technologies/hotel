<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Room maintenance requests carry the guest room. -->
    <record id="hotel.maintenance_request_view_form" model="ir.ui.view">
        <field name="name">maintenance.request.form.hotel</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="before">
                <field name="room_id"
                       context="{'default_company_id': company_id}"
                       help="Guest room concerned by this request."/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_room" type="object" string="Open Room"
                        invisible="not room_id"/>
            </xpath>
        </field>
    </record>

    <record id="hotel.maintenance_request_view_list" model="ir.ui.view">
        <field name="name">maintenance.request.list.hotel</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="room_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="hotel.maintenance_request_view_search" model="ir.ui.view">
        <field name="name">maintenance.request.search.hotel</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="room_id"/>
                <filter name="filter_rooms" string="Guest Rooms"
                        domain="[('room_id', '!=', False)]"/>
                <group name="group_by">
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel.maintenance_request_view_kanban" model="ir.ui.view">
        <field name="name">maintenance.request.kanban.hotel</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="room_id" invisible="1"/>
                <div t-if="record.room_id.raw_value" class="mb-1">
                    <span class="badge text-bg-primary">
                        <i class="fa fa-bed me-1"/>Room <field name="room_id"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>


    <!-- Guest folio: the invoice links back to the stay. -->
    <record id="hotel.account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form.hotel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="hotel_reservation_id"
                       invisible="not hotel_reservation_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="hotel.account_move_view_list" model="ir.ui.view">
        <field name="name">account.move.list.hotel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="hotel_reservation_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
