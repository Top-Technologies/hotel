<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hotel_room_service_view_list" model="ir.ui.view">
        <field name="name">hotel.room.service.order.list</field>
        <field name="model">hotel.room.service.order</field>
        <field name="arch" type="xml">
            <list string="Room Service Orders"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'sent'">
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="room_id"/>
                <field name="guest_id" optional="show"/>
                <field name="order_date" optional="show"/>
                <field name="config_id" optional="hide"/>
                <field name="employee_id" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="pos_reference" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'sent'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="hotel_room_service_view_form" model="ir.ui.view">
        <field name="name">hotel.room.service.order.form</field>
        <field name="model">hotel.room.service.order</field>
        <field name="arch" type="xml">
            <form string="Room Service Order">
                <header>
                    <button name="action_send_to_pos" type="object"
                            string="Send to Point of Sale"
                            class="btn-primary"
                            groups="hotel.group_hotel_manager,hotel.group_receptionist"
                            invisible="state != 'draft'"/>
                    <button name="action_open_pos_order" type="object"
                            string="Open POS Order"
                            class="btn-secondary"
                            invisible="not pos_order_id"/>
                    <button name="action_print_ticket" type="object"
                            string="Print Ticket"
                            class="btn-secondary"
                            invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_pos_order" type="object"
                                class="oe_stat_button" icon="fa-cutlery"
                                invisible="not pos_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">POS Order</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>Room <field name="room_id"
                                          domain="[('active', '=', True), ('reservation_ids.state', '=', 'checked_in')]"/>
                            <span invisible="not guest_id"> - </span>
                            <field name="guest_id" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"
                                   domain="[('active', '=', True), ('reservation_ids.state', '=', 'checked_in')]"/>
                            <field name="reservation_id"/>
                            <field name="order_date"/>
                            <field name="employee_id" groups="hr.group_hr_user"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="pos_order_id" readonly="1"/>
                            <field name="pos_reference" readonly="1"
                                   invisible="not pos_reference"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal"/>
                            <field name="note" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_total"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Kitchen instructions, allergies, delivery time..."/>
                        </page>
                        <page string="Folio Lines" name="folio" readonly="1">
                            <field name="folio_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="billable"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_room_service_view_search" model="ir.ui.view">
        <field name="name">hotel.room.service.order.search</field>
        <field name="model">hotel.room.service.order</field>
        <field name="arch" type="xml">
            <search string="Room Service Orders">
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent to POS" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('order_date', '>=', (context_today().isoformat() + ' 00:00:00')),
                                 ('order_date', '&lt;=', (context_today().isoformat() + ' 23:59:59'))]"/>
                <separator/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Reservation" name="group_reservation" context="{'group_by': 'reservation_id'}"/>
                    <filter string="Point of Sale" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'order_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel_room_service_action" model="ir.actions.act_window">
        <field name="name">Room Service Orders</field>
        <field name="res_model">hotel.room.service.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Take a food order for an in-house guest</p>
            <p>
                The order is sent to the restaurant Point of Sale for the kitchen
                and charged to the guest folio, to be paid at check-out.
            </p>
        </field>
    </record>

    <!-- History: everything already sent to the POS (or cancelled). -->
    <record id="hotel_room_service_history_action" model="ir.actions.act_window">
        <field name="name">Food Order History</field>
        <field name="res_model">hotel.room.service.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hotel_room_service_view_search"/>
        <field name="domain">[('state', 'in', ('sent', 'cancelled'))]</field>
        <field name="context">{'search_default_filter_sent': 1}</field>
    </record>

</odoo>
