<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rooms -->
    <record id="hotel_room_view_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list string="Rooms" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="number"/>
                <field name="name"/>
                <field name="floor"/>
                <field name="room_type_id"/>
                <field name="capacity"/>
                <field name="base_price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="stay_count" string="Stays" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hotel_room_view_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Room" class="o_hotel_form">
                <header>
                    <button name="action_request_maintenance" type="object"
                            string="Request Maintenance" class="oe_highlight"/>
                    <button name="action_request_cleaning" type="object"
                            string="Request Cleaning" invisible="status == 'cleaning'"/>
                    <button name="action_set_out_of_service" type="object"
                            string="Out of Service" invisible="status == 'out_of_service'"/>
                    <button name="action_return_to_service" type="object"
                            string="Return to Service" class="btn-secondary"
                            invisible="status != 'out_of_service'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,clean,dirty,occupied"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_reservations" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="stay_count == 0">
                            <field name="stay_count" widget="statinfo" string="Stays"/>
                        </button>
                        <button name="action_open_maintenance" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                        <button name="action_open_housekeeping" type="object"
                                class="oe_stat_button" icon="fa-paint-brush">
                            <field name="cleaning_count" widget="statinfo" string="Cleanings"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="number" string="Room"/>
                        <h1><field name="number" placeholder="e.g. 204"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="floor"/>
                            <field name="room_type_id"/>
                            <field name="capacity"/>
                            <field name="is_sellable"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amenities">
                            <field name="amenity_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Billing">
                            <field name="product_id" readonly="1"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Room board: rooms grouped by status, used by reception each morning. -->
    <record id="hotel_room_view_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="status"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">Room <field name="number"/></strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="room_type_id"/>
                                </small>
                            </div>
                            <span class="badge text-bg-light"><field name="floor"/></span>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="capacity"/> <span class="text-muted">guests</span></div>
                            <div class="text-muted">
                                <field name="base_price" widget="monetary"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="o_kanban_record_tags">
                                <field name="amenity_ids" widget="many2many_tags"
                                       options="{'color_field': False}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hotel_room_view_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search string="Rooms">
                <field name="number"/>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="amenity_ids"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="sellable" string="Ready to Sell"
                        domain="[('status', 'in', ('clean','inspected'))]"/>
                <filter name="available" string="Available"
                        domain="[('status', 'in', ('available','clean','inspected'))]"/>
                <filter name="occupied" string="Occupied" domain="[('status', '=', 'occupied')]"/>
                <filter name="to_clean" string="To Clean"
                        domain="[('status', 'in', ('dirty','cleaning'))]"/>
                <filter name="out_of_service" string="Out of Service"
                        domain="[('status', '=', 'out_of_service')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor'}"/>
                    <filter string="Room Type" name="group_type"
                            context="{'group_by': 'room_type_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="hotel_room_view_search"/>
        <field name="context">{'search_default_sellable': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No room is ready to sell yet</p>
            <p>Start by creating room types and the rooms of the hotel.</p>
        </field>
    </record>

    <!-- Maintenance requests raised on a guest room. -->
    <record id="hotel_room_maintenance_action" model="ir.actions.act_window">
        <field name="name">Room Maintenance</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('room_id', '!=', False)]</field>
        <field name="context">{'search_default_todo': 1, 'default_maintenance_type': 'corrective'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No maintenance request on a guest room</p>
            <p>Creating a request on a room takes it out of service. Moving it to
                <i>Repaired</i> sets the room back to dirty and creates the cleaning task.</p>
        </field>
    </record>

</odoo>
