<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hotel_lost_found_view_search" model="ir.ui.view">
        <field name="name">hotel.lost.found.search</field>
        <field name="model">hotel.lost.found</field>
        <field name="arch" type="xml">
            <search string="Lost &amp; Found">
                <field name="name"/>
                <field name="description"/>
                <field name="category_id"/>
                <field name="storage_location_id"/>
                <field name="previous_guest_id"/>
                <field name="claimed_by_id"/>
                <filter name="open_items" string="Open"
                        domain="[('state', 'in', ['found', 'stored', 'claim_requested', 'verified', 'unclaimed'])]"/>
                <filter name="stored_items" string="Stored" domain="[('state', '=', 'stored')]"/>
                <filter name="claims" string="Claims to Verify"
                        domain="[('state', '=', 'claim_requested')]"/>
                <filter name="verified" string="Verified Claims"
                        domain="[('state', '=', 'verified')]"/>
                <separator/>
                <filter name="old_items" string="Kept Over 30 Days"
                        domain="[('state', 'in', ['stored', 'unclaimed']),
                                ('found_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="closed" string="Closed"
                        domain="[('state', 'in', ['returned', 'transferred', 'disposed'])]"/>
                <group name="group_by">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Item Type"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_location" string="Storage Location"
                            context="{'group_by': 'storage_location_id'}"/>
                    <filter name="group_claimant" string="Claimant"
                            context="{'group_by': 'claimed_by_id'}"/>
                    <filter name="group_month" string="Found Month"
                            context="{'group_by': 'found_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel_lost_found_view_list" model="ir.ui.view">
        <field name="name">hotel.lost.found.list</field>
        <field name="model">hotel.lost.found</field>
        <field name="arch" type="xml">
            <list string="Lost &amp; Found"
                  decoration-muted="state in ('disposed', 'transferred')"
                  decoration-success="state in ('returned', 'verified')"
                  decoration-warning="state == 'claim_requested'">
                <field name="name"/>
                <field name="description"/>
                <field name="category_id"/>
                <field name="found_date"/>
                <field name="found_location"/>
                <field name="storage_location_id"/>
                <field name="previous_guest_id"/>
                <field name="claimed_by_id"/>
                <field name="days_in_storage" string="Days Stored"/>
                <field name="state" widget="badge"
                       decoration-primary="state == 'found'"
                       decoration-info="state == 'stored'"
                       decoration-warning="state in ('claim_requested', 'unclaimed')"
                       decoration-success="state in ('verified', 'returned')"/>
            </list>
        </field>
    </record>

    <record id="hotel_lost_found_view_kanban" model="ir.ui.view">
        <field name="name">hotel.lost.found.kanban</field>
        <field name="model">hotel.lost.found</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="color_index"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="description"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="name"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="category_id"/></div>
                                <div t-if="record.storage_location_id">
                                    <field name="storage_location_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="days_in_storage" string="days"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="claimed_by_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hotel_lost_found_view_form" model="ir.ui.view">
        <field name="name">hotel.lost.found.form</field>
        <field name="model">hotel.lost.found</field>
        <field name="arch" type="xml">
            <form string="Lost &amp; Found Item">
                <header>
                    <button name="action_store" type="object" string="Store"
                            class="btn-primary" invisible="state != 'found'"/>
                    <button name="action_request_claim" type="object" string="Request Claim"
                            groups="hotel.group_receptionist"
                            invisible="state not in ('stored', 'unclaimed')"/>
                    <button name="action_verify_claim" type="object" string="Verify Claim"
                            class="btn-primary"
                            groups="hotel.group_receptionist"
                            invisible="state != 'claim_requested'"
                            confirm="Confirm you checked the claimant ID against this item?"/>
                    <button name="action_return" type="object" string="Return to Claimant"
                            class="btn-primary"
                            groups="hotel.group_receptionist"
                            invisible="state != 'verified'"/>
                    <button name="action_reject_claim" type="object" string="Reject Claim"
                            invisible="state != 'claim_requested'"/>
                    <button name="action_mark_unclaimed" type="object" string="Mark Unclaimed"
                            invisible="state not in ('found', 'stored', 'claim_requested')"/>
                    <button name="action_transfer" type="object" string="Transfer"
                            invisible="state not in ('stored', 'unclaimed')"/>
                    <button name="action_dispose" type="object" string="Dispose"
                            invisible="state not in ('stored', 'unclaimed')"/>
                    <button name="action_open_lost_found_report" type="object" string="Print Label"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="found,stored,claim_requested,verified,returned"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'claim_requested'">
                        Claim awaiting verification. Confirm claimant identity, match
                        the description, attach ID evidence, then Verify Claim.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="description" placeholder="Item description"/></h3>
                    </div>
                    <group>
                        <group string="Item">
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="quantity"/>
                        </group>
                        <group string="Found">
                            <field name="found_date"/>
                            <field name="found_by_id"/>
                            <field name="found_location"/>
                            <field name="found_room_id"/>
                            <field name="storage_location_id"/>
                            <field name="days_in_storage"/>
                        </group>
                        <group string="Previous Guest">
                            <field name="previous_guest_id"/>
                            <field name="previous_reservation_id"/>
                        </group>
                        <group string="Claim Verification">
                            <field name="claimed_by_id"/>
                            <field name="claim_reference"
                                   placeholder="Passport / booking ref"/>
                            <field name="claim_id_document"
                                   filename="claim_id_document_filename"
                                   widget="binary"/>
                            <field name="claim_id_document_filename" invisible="1"/>
                            <field name="claim_verification_notes"
                                   placeholder="What was checked to verify this claim?"
                                   invisible="state not in ('claim_requested', 'verified', 'returned')"/>
                            <field name="claim_date" readonly="1"/>
                            <field name="verified" readonly="1"/>
                            <field name="verified_by_id" readonly="1"/>
                            <field name="verified_date" readonly="1"/>
                        </group>
                        <group string="Disposal" invisible="state not in ('disposed', 'transferred')">
                            <field name="disposal_method"/>
                            <field name="disposal_date" readonly="1"/>
                            <field name="transfer_to"/>
                        </group>
                        <group string="Return" invisible="state not in ('verified', 'returned')">
                            <field name="returned_to" readonly="state == 'returned'"/>
                            <field name="returned_by_id" readonly="1"/>
                            <field name="returned_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Where and how the item was found"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_lost_found_action" model="ir.actions.act_window">
        <field name="name">Lost &amp; Found</field>
        <field name="res_model">hotel.lost.found</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="hotel_lost_found_view_search"/>
        <field name="context">{'search_default_open_items': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register items found in the rooms or
                handed in by guests, and follow their claims until they are returned.</p>
        </field>
    </record>


    <record id="hotel_lost_found_claims_action" model="ir.actions.act_window">
        <field name="name">Claims to Verify</field>
        <field name="res_model">hotel.lost.found</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hotel_lost_found_view_search"/>
        <field name="context">{'search_default_claims': 1}</field>
        <field name="domain">[('state', '=', 'claim_requested')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No claims waiting for verification.
                When a guest claims an item, verify ID evidence here before returning it.</p>
        </field>
    </record>

</odoo>
