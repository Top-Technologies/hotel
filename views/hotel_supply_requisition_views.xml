<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Supply Requisition List View -->
    <record id="hotel_supply_requisition_view_list" model="ir.ui.view">
        <field name="name">hotel.supply.requisition.list</field>
        <field name="model">hotel.supply.requisition</field>
        <field name="arch" type="xml">
            <list string="Cart Supplies Requisitions">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="source_location_id"/>
                <field name="dest_location_id"/>
                <field name="picking_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'requested'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Supply Requisition Form View -->
    <record id="hotel_supply_requisition_view_form" model="ir.ui.view">
        <field name="name">hotel.supply.requisition.form</field>
        <field name="model">hotel.supply.requisition</field>
        <field name="arch" type="xml">
            <form string="Cart Supplies Requisition" class="o_hotel_form">
                <header>
                    <button name="action_request" type="object" string="Submit Requisition"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate Received Supplies"
                            class="btn-success" invisible="state != 'requested'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Stock Transfer</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="dest_location_id" readonly="state != 'draft'"/>
                            <field name="picking_id" readonly="1" invisible="not picking_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Items" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" string="Items">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="warehouse_qty" optional="show"/>
                                    <field name="cart_qty" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes or instructions for warehouse staff..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="hotel_supply_requisition_view_search" model="ir.ui.view">
        <field name="name">hotel.supply.requisition.search</field>
        <field name="model">hotel.supply.requisition</field>
        <field name="arch" type="xml">
            <search string="Search Requisitions">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="source_location_id"/>
                <field name="dest_location_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Requested" name="requested" domain="[('state', '=', 'requested')]"/>
                <filter string="Transferred" name="done" domain="[('state', '=', 'done')]"/>
                <group name="group_by">
                    <filter string="Staff" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Request Date" name="group_by_date" context="{'group_by': 'request_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_supply_requisition" model="ir.actions.act_window">
        <field name="name">Cart Supplies Requisitions</field>
        <field name="res_model">hotel.supply.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hotel_supply_requisition_view_search"/>
        <field name="context">{'search_default_requested': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Request room consumables and supplies from the main warehouse to your cart.
            </p>
        </field>
    </record>

</odoo>
