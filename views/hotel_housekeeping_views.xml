<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Housekeeping tasks -->
    <record id="hotel_housekeeping_task_view_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.kanban</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="0" sample="1" class="o_hotel_housekeeping_kanban">
                <field name="room_id"/>
                <field name="employee_id"/>
                <field name="floor"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    Room <field name="room_id" display="number"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    Floor <field name="floor"/>
                                </small>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="employee_id" placeholder="Unassigned"/></div>
                            <div class="text-muted">
                                <field name="date"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="o_kanban_record_bottom_left">
                                <field name="duration_minutes" widget="float_time"/>
                            </div>
                            <div class="o_kanban_record_bottom_right">
                                <field name="activity_ids" widget="kanban_activity"/>
                                <field name="message_needaction" widget="kanban_activity"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_buttons">
                            <button name="action_start" type="object" string="Start"
                                    invisible="state != 'pending'"/>
                            <button name="action_done" type="object" string="Done"
                                    invisible="state not in ('pending','in_progress')"/>
                            <button name="action_inspect" type="object" string="Inspect"
                                    groups="hotel.group_housekeeping_supervisor"
                                    invisible="state != 'done'"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hotel_housekeeping_task_view_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.list</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <list string="Cleaning Tasks" multi_edit="1">
                <field name="name"/>
                <field name="room_id"/>
                <field name="floor"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state in ('done','inspected')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="duration_minutes" widget="float_time" sum="Minutes"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hotel_housekeeping_task_view_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form string="Cleaning Task">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary" invisible="state not in ('pending','in_progress')"/>
                    <button name="action_inspect" type="object" string="Inspect"
                            groups="hotel.group_housekeeping_supervisor"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done','inspected','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_progress,done,inspected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>Room <field name="room_id"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="floor"/>
                            <field name="room_type_id"/>
                            <field name="reservation_id"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <field name="duration_minutes"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_housekeeping_task_view_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.search</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <search string="Cleaning Tasks">
                <field name="room_id"/>
                <field name="employee_id"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('state','=','pending')]"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state','=','in_progress')]"/>
                <filter name="filter_done" string="Done"
                        domain="[('state','in',('done','inspected'))]"/>
                <separator/>
                <filter name="filter_my_tasks" string="My Tasks"
                        domain="[('user_id','=',uid)]"/>
                <filter name="filter_unassigned" string="Unassigned"
                        domain="[('employee_id','=',False)]"/>
                <filter name="filter_today" string="Today"
                        domain="[('date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Average cleaning time per employee: pivot on duration by employee. -->
    <record id="hotel_housekeeping_task_view_pivot" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.pivot</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <pivot string="Cleaning Performance" sample="1">
                <field name="employee_id" type="row"/>
                <field name="date" type="col"/>
                <field name="duration_minutes" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hotel_housekeeping_task_action" model="ir.actions.act_window">
        <field name="name">Cleaning Tasks</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">kanban,list,form,pivot</field>
        <field name="search_view_id" ref="hotel_housekeeping_task_view_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cleaning task pending</p>
            <p>A cleaning task is created automatically when a guest checks out. Housekeepers
                open this board on their phone, tap <i>Start</i> and then <i>Done</i>.</p>
        </field>
    </record>

    <record id="hotel_housekeeping_my_task_action" model="ir.actions.act_window">
        <field name="name">My Cleaning Tasks</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="hotel_housekeeping_task_view_search"/>
        <field name="domain">[('state', 'in', ('pending', 'in_progress'))]</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <!-- Supervisor inspection: only completed tasks waiting for review. -->
    <record id="hotel_housekeeping_inspection_action" model="ir.actions.act_window">
        <field name="name">Room Inspection</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="hotel_housekeeping_task_view_search"/>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cleaned room waiting for inspection</p>
            <p>Completed cleaning tasks appear here. Open a room, check it and press
                <i>Inspect</i> to mark the room ready to sell.</p>
        </field>
    </record>

</odoo>
