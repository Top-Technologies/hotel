<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Guest complaints -->
    <record id="hotel_complaint_view_list" model="ir.ui.view">
        <field name="name">hotel.complaint.list</field>
        <field name="model">hotel.complaint</field>
        <field name="arch" type="xml">
            <list string="Guest Complaints" multi_edit="1">
                <field name="name"/>
                <field name="reported_date"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="floor"/>
                <field name="category"/>
                <field name="priority" widget="priority"/>
                <field name="employee_id"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'new'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('resolved','closed')"/>
                <field name="resolution_hours" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hotel_complaint_view_form" model="ir.ui.view">
        <field name="name">hotel.complaint.form</field>
        <field name="model">hotel.complaint</field>
        <field name="arch" type="xml">
            <form string="Guest Complaint" class="o_hotel_form">
                <header>
                    <button name="action_start" type="object" string="Investigate"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_resolve" type="object" string="Resolve"
                            class="btn-primary" invisible="state not in ('new','in_progress')"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'resolved'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state not in ('resolved','closed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="category"/></h3>
                    </div>
                    <group>
                        <group string="Complaint">
                            <field name="guest_id"/>
                            <field name="reservation_id"/>
                            <field name="room_id"/>
                            <field name="floor"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Handling">
                            <field name="employee_id"/>
                            <field name="reported_date"/>
                            <field name="reported_month"/>
                            <field name="resolved_date"/>
                            <field name="resolution_hours"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Action Taken">
                            <field name="action_taken"
                                   placeholder="e.g. Guest moved to room 210"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_complaint_view_kanban" model="ir.ui.view">
        <field name="name">hotel.complaint.kanban</field>
        <field name="model">hotel.complaint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="employee_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="category"/>
                                </small>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="guest_id"/></div>
                            <div class="text-muted">Room <field name="room_id"/></div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="o_kanban_record_bottom_left">
                                <field name="employee_id" placeholder="Unassigned"/>
                            </div>
                            <div class="o_kanban_record_bottom_right">
                                <field name="activity_ids" widget="kanban_activity"/>
                                <field name="message_needaction" widget="kanban_activity"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hotel_complaint_view_pivot" model="ir.ui.view">
        <field name="name">hotel.complaint.pivot</field>
        <field name="model">hotel.complaint</field>
        <field name="arch" type="xml">
            <pivot string="Complaints by Category and Month" sample="1">
                <field name="category" type="row"/>
                <field name="reported_month" type="col"/>
                <field name="resolution_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hotel_complaint_view_graph" model="ir.ui.view">
        <field name="name">hotel.complaint.graph</field>
        <field name="model">hotel.complaint</field>
        <field name="arch" type="xml">
            <graph string="Complaints by Category" sample="1">
                <field name="category"/>
                <field name="floor"/>
            </graph>
        </field>
    </record>

    <record id="hotel_complaint_view_search" model="ir.ui.view">
        <field name="name">hotel.complaint.search</field>
        <field name="model">hotel.complaint</field>
        <field name="arch" type="xml">
            <search string="Complaints">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <filter name="filter_new" string="New" domain="[('state','=','new')]"/>
                <filter name="filter_open" string="Open"
                        domain="[('state','in',('new','in_progress'))]"/>
                <filter name="filter_resolved" string="Resolved"
                        domain="[('state','in',('resolved','closed'))]"/>
                <separator/>
                <filter name="filter_high" string="High Priority"
                        domain="[('priority','in',('high','critical'))]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category'}"/>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by': 'reported_month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel_complaint_action" model="ir.actions.act_window">
        <field name="name">Guest Complaints</field>
        <field name="res_model">hotel.complaint</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="hotel_complaint_view_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No guest complaint recorded</p>
            <p>Log what the guest complained about, against the stay and the room, and follow
                the action taken up to resolution. The pivot view shows complaints per category
                and month; the graph shows which floors are the problem.</p>
        </field>
    </record>

</odoo>
