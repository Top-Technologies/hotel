<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Hotel Menu -->
    <menuitem id="menu_hotel_root" name="Hotel" sequence="5" web_icon="hotel,static/description/icon.svg"/>

    <!-- Dashboard - Top Priority -->
    <menuitem id="menu_hotel_dashboard" name="Dashboard"
              parent="menu_hotel_root" action="action_hotel_reservations_dashboard"
              sequence="1" groups="hotel.group_hotel_user"/>

    <!-- Front Desk (reception operations grouped together) -->
    <menuitem id="menu_hotel_front_desk" name="Front Desk"
              parent="menu_hotel_root" sequence="10"
              groups="hotel.group_receptionist"/>

    <!-- Reservations -->
    <menuitem id="menu_hotel_reservations" name="Reservations"
