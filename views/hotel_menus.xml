    <menuitem id="menu_hotel_lost_found" name="All Items"
              parent="menu_hotel_lost_found_root" action="hotel_lost_found_action"
              sequence="10"/>

    <menuitem id="menu_hotel_lost_found_claims" name="Claims to Verify"
