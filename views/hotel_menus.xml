              sequence="10" groups="hotel.group_receptionist"/>

    <menuitem id="menu_hotel_walkins" name="Book"
              parent="menu_hotel_reservations"
              action="hotel_reservation_book_action" sequence="5"
              groups="hotel.group_receptionist"/>

