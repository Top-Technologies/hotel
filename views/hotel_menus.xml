              parent="menu_hotel_root" sequence="65"
              groups="hotel.group_hotel_user"/>

    <menuitem id="menu_hotel_approvals_rate" name="Rate Changes"
              parent="menu_hotel_approvals"
              action="hotel_rate_change_action" sequence="10"/>

    <menuitem id="menu_hotel_approvals_discount" name="Discount Requests"
              parent="menu_hotel_approvals"
              action="hotel_discount_approval_action" sequence="20"/>

    <menuitem id="menu_hotel_approvals_credit" name="Credit Requests"
