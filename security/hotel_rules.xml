<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Housekeepers only see the tasks of the pool: unassigned ones and their own. -->
        <record id="rule_hotel_housekeeping_task_own" model="ir.rule">
            <field name="name">Housekeeping: pool and own tasks</field>
            <field name="model_id" ref="model_hotel_housekeeping_task"/>
            <field name="domain_force">
                ['|',
                 ('employee_id', '=', False),
                 ('employee_id', '=', user.employee_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_housekeeping'))]"/>
        </record>

        <!-- Receptionists and managers see the whole hotel: no rule needed. -->

        <!-- Housekeepers record found items and follow up the ones they picked up;
             reception, security and managers keep the full register. -->
        <record id="rule_hotel_lost_found_own" model="ir.rule">
            <field name="name">Lost &amp; Found: items recorded by me</field>
            <field name="model_id" ref="model_hotel_lost_found"/>
            <field name="domain_force">[('found_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_housekeeping'))]"/>
        </record>

        <record id="rule_hotel_lost_found_manager_all" model="ir.rule">
            <field name="name">Lost &amp; Found: full register for managers</field>
            <field name="model_id" ref="model_hotel_lost_found"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hotel_manager'))]"/>
        </record>

        <!-- ===== Multi-Company Record Rules ===== -->
        <!-- These rules are global (no group): every user only sees records of their allowed companies. -->

        <record id="rule_hotel_reservation_company" model="ir.rule">
            <field name="name">Hotel Reservation: company</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

