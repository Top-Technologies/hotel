<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hotel_checkin_wizard_view_form" model="ir.ui.view">
        <field name="name">hotel.checkin.wizard.form</field>
        <field name="model">hotel.checkin.wizard</field>
        <field name="arch" type="xml">
            <form string="Guest Check-in">
                <group>
                    <group string="Stay">
                        <field name="reservation_id" invisible="1"/>
                        <field name="guest_id"/>
                        <field name="room_id"/>
                        <field name="checkin"/>
                        <field name="checkout"/>
                    </group>
                    <group string="Registration">
                        <field name="id_type"/>
                        <field name="id_number"/>
                        <field name="id_document"
                               filename="id_document_filename"
                               widget="binary"/>
                        <field name="id_document_filename" invisible="1"/>
                        <field name="nationality_id"/>
                        <field name="phone" widget="phone"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="adults"/>
                        <field name="children"/>
                        <field name="registered_guests"/>
                    </group>
                    <group string="Deposit / Advance">
                        <field name="deposit"/>
                        <field name="deposit_paid"/>
                        <field name="amount_to_collect"/>
                        <field name="payment_journal_id"
                               invisible="amount_to_collect &lt;= 0"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="print_card"/>
                    </group>
                </group>
                <group string="Notes">
                    <field name="notes" nolabel="1" placeholder="Optional note about the arrival"/>
                </group>
                <footer>
                    <button name="action_confirm_checkin" type="object" string="Check In"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
