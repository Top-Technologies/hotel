    <template id="report_lost_found_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>LOST &amp; FOUND REPORT</h2>
                <table class="table table-sm mt-3">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Item</th>
                            <th>Type</th>
                            <th>Found on</th>
                            <th>Where</th>
                            <th>Storage</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="doc">
                            <td><span t-field="doc.name"/></td>
                            <td><span t-field="doc.description"/></td>
                            <td><span t-field="doc.category_id.name"/></td>
                            <td><span t-field="doc.found_date"/></td>
                            <td>
                                <span t-field="doc.found_location"/>
                                <span t-field="doc.found_room_id.number"/>
                            </td>
                            <td><span t-field="doc.storage_location_id.name"/></td>
                            <td><span t-field="doc.state"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_lost_found">
        <t t-call="web.html_container">
            <t t-call="hotel.report_lost_found_document"/>
        </t>
    </template>

