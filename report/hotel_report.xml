        <field name="binding_model_id" ref="model_hotel_lost_found"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_guest_property_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>GUEST PROPERTY CARD</h2>
                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Reference</strong>
                        <span t-field="doc.name"/>
                    </div>
                    <div class="col-6">
                        <strong>Status</strong>
                        <span t-field="doc.state"/>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <strong>Guest</strong>
                        <span t-field="doc.guest_id.name"/>
                    </div>
                    <div class="col-6">
                        <strong>Room</strong>
                        <span t-field="doc.room_id.number"/>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <strong>Reservation</strong>
                        <span t-field="doc.reservation_id.name"/>
                    </div>
                    <div class="col-6">
                        <strong>Category</strong>
                        <span t-field="doc.category_id.name"/>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <strong>Item</strong>
                        <span t-field="doc.description"/>
                        (qty <span t-field="doc.quantity"/>)
                    </div>
                    <div class="col-6">
                        <strong>Serial / ID</strong>
                        <span t-field="doc.serial_number"/>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <strong>Condition</strong>
                        <span t-field="doc.condition"/>
                    </div>
                    <div class="col-6">
                        <strong>Storage location</strong>
                        <span t-field="doc.current_location_id.name"/>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <strong>Received</strong>
                        <span t-field="doc.received_date"/>
                        by <span t-field="doc.received_by_id.name"/>
                    </div>
                    <div class="col-6">
                        <strong>Expected return</strong>
                        <span t-field="doc.expected_return_date"/>
                    </div>
                </div>
                <t t-if="doc.returned_date">
                    <div class="row mt-2">
                        <div class="col-12">
                            <strong>Returned</strong>
                            <span t-field="doc.returned_date"/>
                            to <span t-field="doc.returned_to"/>
                            by <span t-field="doc.returned_by_id.name"/>
                        </div>
                    </div>
                </t>
                <t t-if="doc.notes">
                    <p class="mt-3"><strong>Notes:</strong> <span t-field="doc.notes"/></p>
                </t>
                <h3 class="mt-4">Custody chain</h3>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>From</th>
                            <th>To</th>
                            <th>By</th>
                            <th>Condition</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.custody_ids.sorted(lambda c: (c.custody_date, c.id))"
                            t-as="line">
                            <td><span t-field="line.custody_date"/></td>
                            <td><span t-field="line.action"/></td>
                            <td><span t-field="line.from_location_id.name"/></td>
                            <td><span t-field="line.to_location_id.name"/></td>
                            <td><span t-field="line.user_id.name"/></td>
                            <td><span t-field="line.condition"/></td>
                        </tr>
                    </tbody>
                </table>
                <p class="mt-4">
                    Guest signature: .....................................
                    Staff signature: .....................................
                </p>
            </div>
        </t>
    </template>

    <template id="report_guest_property">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hotel.report_guest_property_document"/>
            </t>
        </t>
    </template>

