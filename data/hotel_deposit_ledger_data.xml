<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_deposit_ledger" model="ir.cron">
            <field name="name">Deposit Ledger: send due schedules</field>
            <field name="model_id" ref="model_hotel_deposit_ledger_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="mail_template_deposit_ledger" model="mail.template">
            <field name="name">Deposit Ledger</field>
            <field name="model_id" ref="model_hotel_deposit_ledger_schedule"/>
            <field name="subject">Deposit Ledger</field>
            <field name="body_html"><![CDATA[
                <p>Attached is the Deposit Ledger.</p>
            ]]></field>
            <field name="email_to">{{ object.recipient_ids | map(attribute='email') | join(',') }}</field>
        </record>
    </data>
</odoo>
