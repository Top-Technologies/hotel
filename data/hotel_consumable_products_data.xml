            <field name="purchase_ok" eval="True"/>
            <field name="list_price">120.00</field>
            <field name="standard_price">50.00</field>
            <field name="hotel_consumption_ok" eval="True"/>
            <field name="hotel_consumption_policy">chargeable</field>
            <field name="default_code">MB-NUTS-01</field>
        </record>

        <!-- SERVICE: Laundry Per Piece -->
        <record id="product_laundry_service" model="product.template">
            <field name="name">Laundry Service (Per Piece)</field>
            <field name="categ_id" ref="product_category_laundry"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
