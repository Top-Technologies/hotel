        </record>

        <!-- CHARGEABLE: Minibar Cola -->
        <record id="product_minibar_cola" model="product.template">
            <field name="name">Minibar Cola (250ml)</field>
            <field name="categ_id" ref="product_category_minibar"/>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
