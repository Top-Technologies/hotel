        <!-- CHARGEABLE: Minibar Chocolate Bar -->
        <record id="product_minibar_chocolate" model="product.template">
            <field name="name">Minibar Chocolate Bar</field>
            <field name="categ_id" ref="product_category_minibar"/>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price">100.00</field>
            <field name="standard_price">40.00</field>
            <field name="hotel_consumption_ok" eval="True"/>
            <field name="hotel_consumption_policy">chargeable</field>
            <field name="default_code">MB-CHOCO-01</field>
